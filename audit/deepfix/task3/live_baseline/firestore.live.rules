// ============================================================================
// DEEPFIX2 MERGED RULES ARTIFACT — live base + review-v2 clauses (17_ §7b)
// BASE: the ruleset LIVE in production, fetched 2026-08-03 by fetch-live-rules.mjs
//   (rulesets/d8f3e0d0-8e8b-4fe1-aff8-9aceb1d5f9c4, created 2026-06-28,
//   sha256 44914b60858a1dcd… — re-verify freshness at deploy time; a drifted
//   sha means RE-DERIVE this merge).
// CLAUSES: authored from audit/deepfix/task3/firestore.review_v2.rules (the
//   131-line SPEC) against THIS base's shape. Deltas: (A) the users/{uid}
//   subcollection write split with the nine-new-subcollection exclusion + the
//   six-label study_states guards; (B) attempt override-key guards on the two
//   live client write branches; (C) four new top-level matches. NO P6/P10
//   narrowing is introduced: list_progress/class_progress/progress_meta and
//   the legacy attempt writes stay exactly as live (the inertness law).
// NOT the repo's firestore.rules (that is the unshipped P10 end-state).
// WHAT THIS FILE DELIBERATELY DOES **NOT** CLOSE — do not read it as forge-proof:
//   * `currentStudyDay` / `totalWordsIntroduced` (csd/twi) stay OWNER-WRITABLE.
//     The engine reads them as the frontier and review-universe authority
//     (functions/reviewV2/progress.js:62-70), so a student can still forge their
//     own day position. That is the LIVE legacy posture the app depends on; its
//     closure is carded to P6/DF2-46, and matrix case 10b asserts it as a
//     DEFERRED SURFACE, never as an inertness proof.
//   * Client attempt create / answers-only update / plain delete stay legal
//     (load-bearing until DF2-46), so attempt HISTORY remains client-shaped —
//     WITH ONE EXCEPTION as of [codex r78]: a client update of ANY kind is refused
//     when the EXISTING attempt is engine-stamped (isEngineStampedAttempt()). The
//     legacy answers-only update is untouched; only engine evidence, which does
//     not exist in the live base, is frozen against the client. See the attempts
//     update clause for the marker-set compatibility decision.
//   * `role` is self-asserted at signup, so `isTeacher()` is an availability
//     gate, not a confidentiality boundary (see the users block).
//   * `users/{uid}.enrolledClasses` is OWNER-WRITABLE and the server reads it as
//     an entitlement OR-branch (functions/index.js:321, foundation.js:326 and
//     :2486), so a student can self-grant engine access to a class they were
//     never enrolled in. Not a regression (identical to the live base); carded
//     PRE-FLIP, and it needs a cohort data-check first because "phantom members"
//     may legitimately depend on that fallback.
//   * `classes.studentIds` can be rewritten by ANY authenticated user (the
//     self-enroll branch binds nothing to request.auth.uid) and review-v2 makes
//     it BINDING at transaction time (reviewV2/config.js:180-182, :270). Same
//     status: live-base behaviour, carded pre-flip.
//   * `answers[].gradedIsCorrect` — the §6b append-only grading preimage — is
//     rewritable through the student answers-only branch, and the GATE-4 backfill
//     consumes it as authority (b1-replay-lib.mjs:99). Firestore rules cannot
//     inspect fields inside array elements, so this is NOT fixable here: the
//     BACKFILL must not trust it unverified. Carded for gate 4.
//   * `writtenBy` / `correctnessSource` are forgeable on client-created attempts
//     — forensic provenance only; no live enforcement path reads them from the
//     document (index.js:452 uses an in-process argument).
//
// TWO DELTA GROUPS, deliberately distinguishable:
//   (1) SPEC-MANDATED — the nine-subcollection exclusion, the six-label
//       study_states guards, the attempt override-key guards (create/update per
//       CLAUSE 5(a); delete added by the r54 erasure law), the four new
//       top-level matches.
//   (2) HARDENING BEYOND THE SPEC (r-panel forgery lens): `role` made
//       create-only (F1), and the server-only reset/epoch fence
//       (resetAt/resetEpoch/resetInProgress) made client-unwritable (F2/F3).
//       BOTH verified inert against the live client tree before authoring.
// Gate: the emulator matrix (rules-matrix.mjs) must pass on THIS file.
// ============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return getUserData().role == 'teacher';
    }

    // ── DEEPFIX2 KEY SETS — declared ONCE, used by every branch ──────────────
    // These exist because the same lists were previously written out per
    // operation, and three separate reviews found the same defect: a key added
    // to one branch's list and missing from the others (delete-then-recreate on
    // `role`; the reset fence with no delete guard; `manualOverride` on delete
    // only). Single definition makes that divergence structurally impossible.

    // Server-written labels on study_states — client-immutable and non-erasable.
    function serverLabelKeys() {
      return ['reviewFailCount', 'reviewLastFailedAt', 'reviewLastCorrectAt',
              'reviewLastProvenAt', 'reviewLastTestedAt', 'reviewRestingUntil'];
    }

    // The reset/epoch fence — server truth (resetProgress, Admin SDK) only.
    function resetFenceKeys() {
      return ['resetAt', 'resetEpoch', 'resetInProgress'];
    }

    // Engine-owned subcollections — no client writes in any operation.
    function serverOwnedSubcollections() {
      return ['review_queues', 'review_presentations', 'day_completions',
              'streak_credits', 'restudy_completions', 'restudy_visits',
              'review_counters', 'review_cursors', 'compose_keys'];
    }

    // The ENGINE's own stamps [panel r5], declared ONCE and consumed THREE ways:
    // the request-side attempt CREATE guard and the request-side TEACHER UPDATE
    // guard (both through serverOnlyAttemptKeys() below), and the RESOURCE-side
    // marked-document guard isEngineStampedAttempt() [codex r78].
    // `resetEpoch` is load-bearing: its mere PRESENCE is the engine/legacy
    // discriminator (reviewV2/completion.js:340), so forging it flips which fence
    // set an attempt is judged under.
    function engineStampKeys() {
      return ['resetEpoch', 'presentationId', 'queueId', 'engineResult'];
    }

    // Attempt markers written only by server/CS surfaces. `manualOverride` is
    // the one with LIVE writers (foundation.js:2985, scripts/cs/manual-pass.mjs:70);
    // the rest are the force-pass surface and the engine's posture stamp.
    // COMPOSED from engineStampKeys() instead of restating those four keys: a
    // second copy of a key list is exactly the divergence that produced the
    // r2/r3/r4/r5 defects, so the request-side and resource-side sets are now
    // structurally incapable of drifting apart.
    function serverOnlyAttemptKeys() {
      return ['manualOverride', 'teacherEdited', 'teacherEditedBy', 'teacherEditedAt',
              'preOverride', 'gatePosture'].concat(engineStampKeys());
    }

    // Is the EXISTING attempt engine evidence? [codex r78 BLOCKER — see the full
    // rationale on the attempts update clause.]
    // A client can author NONE of these four (the attempt create guard denies them),
    // so the presence of any one of them proves the document was server-written.
    // [NTF-20, BOTH LEGS — cited here per its own instruction: bundle the
    // citation with the next real rules change, which is the NTF 19+22
    // namespace-reservation fold.] PROSPECTIVELY the create guard is LIVE
    // (deployed 2026-08-03, win order 97, ruleset 384c9c7a…, sha16
    // f40f91fce3693b82 at deploy time). RETROSPECTIVELY the full-corpus
    // provenance scan (scripts/deepfix2/engine-key-provenance-scan.mjs — a
    // FULL non-orderBy page-through of 41,680 attempts) found ZERO documents
    // carrying ANY of the four engine keys; receipt: audit/deepfix/task3/
    // live_baseline/engine-key-provenance-receipt.json. The claim holds for
    // history too, not only going forward.
    // NULL-RESOURCE NOTE, stated because it is visible in the emulator log and must
    // not be mistaken for a defect: on a set() against a NON-EXISTENT doc the engine
    // evaluates BOTH the create and the update rule, and in the update evaluation
    // `resource` is null, so this raises an evaluation error and that branch denies —
    // while the separate create rule decides the request. This is PRE-EXISTING
    // behaviour, not something this guard introduced: the previous first term of the
    // same clause (`resource.data.studentId == ...`) errored on the identical path.
    // Verified: every create case in the matrix (9-a1, A21, R10, …) stays green.
    function isEngineStampedAttempt() {
      return resource.data.keys().hasAny(engineStampKeys());
    }

    // DEEPFIX2 [NTF 19+22 · 20_RV2_NAMESPACE_RESERVATION.md G1/Leg 2] THE
    // RESERVED ENGINE DOC-ID NAMESPACE. `rv2_` names are the engine's
    // server-derived id family (functions/reviewV2/composer.js engineDocId =
    // `rv2_{uid}_{presentationId}`, written via the Admin SDK for BOTH
    // `attempts` and `grading_jobs`). The names are client-DERIVABLE (uids
    // enumerate from classes.studentIds; presentationId has a small
    // predictable seq), so a classmate could create/squat
    // `attempts/rv2_{victim}_{pid}` and convert the engine's fail-closed
    // provenance checks into a PERMANENT denial of the victim's test
    // (NTF 22). The name test therefore rides EVERY client write verb on
    // attempts — create, update AND delete, not create only: set({merge:true})
    // on a nonexistent doc is a create in different clothing, and the uniform
    // per-verb deny needs no key-presence reasoning. ONE function, called by
    // all three branches, so the verbs never drift apart (the structural-fix
    // law). RE2 full-match semantics => 'rv2_.*' is a prefix test.
    // Denies nothing legitimate: legacy client ids are `{uid}_{testId}_{nonce}`
    // and a Firebase uid is 28-char alphanumeric (no underscore), so no
    // legitimate id can enter the prefix (matrix RV7 + A21 pin the ALLOW
    // direction), and the retrospective corpus scan found 0 rv2_-named docs
    // in 41,688 attempts + 16,732 grading_jobs (audit/deepfix/task3/
    // live_baseline/rv2-docid-precondition-receipt.json). Engine writes are
    // Admin SDK and unaffected; READ is untouched (the client renders its own
    // engine attempt). The live callables carry the same reservation at their
    // mouths (G2/G3, functions/index.js assertNotEngineReservedDocId) —
    // rules alone do not close the Admin-SDK write path (NTF 22 correction).
    function isReservedEngineDocId(attemptId) {
      return attemptId.matches('rv2_.*');
    }

    // ADMIN: Collection group rule for class_progress (enables admin dashboard).
    // Read-only and teacher-only — student/own-progress writes go through the
    // owner rule under /users/{userId}/class_progress.
    // SECURITY: previously `allow read, write: if isAuthenticated();` permitted
    // any authenticated user to corrupt any student's progress doc.
    match /{path=**}/class_progress/{docId} {
      allow read: if isAuthenticated() && isTeacher();
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();

      // DEEPFIX2 [HARDENING, beyond the spec — panel F1, CORRECTED at panel r2]:
      // the live base let an owner rewrite their OWN `role` in place, and
      // isTeacher() reads that field. The write is split so an UPDATE can never
      // touch `role`, and DELETE is closed so the guard cannot be bypassed by
      // delete-then-recreate (panel r2 found that two-call path; my first
      // "create-only" claim was wrong). VERIFIED no live writer: role is
      // written only at doc creation (AuthContext.jsx:75 signup; :113 Google,
      // guarded by !userSnap.exists()); seedFullData.js:958 restates an
      // IDENTICAL value behind TeacherRoute, which diff() omits from
      // affectedKeys (matrix R5); db.js:286 touches profile only; and no CLIENT
      // path deletes a users doc. The one account-deletion flow is
      // scripts/cs/erase-account.mjs (Admin SDK, rules-bypassing), which deletes
      // the users doc AND the Auth identity in the same run — and that
      // auth.deleteUser call is LOAD-BEARING here: `create` is bare isOwner, so
      // a surviving uid whose doc was erased could re-create it as a teacher.
      //
      // WHAT THIS DOES NOT BUY — read before trusting `isTeacher()`:
      // `role` is SELF-ASSERTED AT SIGNUP (src/pages/Signup.jsx:124-149 renders
      // a public "Teacher" radio that db.js:254 writes verbatim), so anyone with
      // an email can hold role:'teacher' from the start. These clauses stop an
      // ESTABLISHED account from escalating in place; they do NOT make 'teacher'
      // a confidentiality boundary. Closing that is a PRODUCT decision (gated
      // teacher registration, or class-scoped teacher grants), carded to David.
      allow create: if isAuthenticated() && isOwner(userId);

      allow update: if isAuthenticated() && (
        (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        (isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challenges']))
      );

      // Closed [panel r2]: delete + recreate was a two-call bypass of the role
      // guard. No client path deletes a users doc, so this denies nothing live.
      allow delete: if false;

      // TODO(security): teacher writes here exist solely to support
      // reviewChallenge (writes student's study_states + class_progress when
      // accepting/rejecting a dispute). This is overly broad — any teacher
      // account can write any student's subcollections regardless of class
      // membership. Follow-up: move reviewChallenge to a Cloud Function
      // (Admin SDK bypasses rules) and tighten this to `isOwner(userId)`.
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isTeacher());

        // DEEPFIX2 review-v2 [CLAUSE 1+2, firestore.review_v2.rules]: the NINE
        // server-owned subcollections accept NO client writes (Admin SDK only),
        // and the SIX server label fields on study_states are client-immutable
        // (create/update) and non-erasable (delete). Everything else preserves
        // the live owner-or-teacher branch verbatim — list_progress /
        // class_progress / progress_meta / plain study_states stay writable
        // exactly as before (the inertness law: only surfaces that do not
        // exist pre-train are guarded).
        allow create: if isAuthenticated() && (isOwner(userId) || isTeacher())
          && !(subcollection in serverOwnedSubcollections())
          && !(subcollection == 'study_states'
               && request.resource.data.keys().hasAny(serverLabelKeys()))
          && !request.resource.data.keys().hasAny(resetFenceKeys());

        allow update: if isAuthenticated() && (isOwner(userId) || isTeacher())
          && !(subcollection in serverOwnedSubcollections())
          && !(subcollection == 'study_states'
               && request.resource.data.diff(resource.data).affectedKeys().hasAny(serverLabelKeys()))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(resetFenceKeys());

        allow delete: if isAuthenticated() && (isOwner(userId) || isTeacher())
          && !(subcollection in serverOwnedSubcollections())
          && !(subcollection == 'study_states'                     // label-ERASURE guard [r54]
               && resource.data.keys().hasAny(serverLabelKeys()))
          // The reset fence must survive DELETION too [panel r3 BLOCKER]: guarding
          // only create+update left delete-then-recreate as a clean bypass, which
          // would fork the day_completions CAS namespace (composer.js:154 reads 0
          // for an absent doc), clear the §2b fail-closed reset lock
          // (composer.js:166), and walk the GATE-4 backfill past its own drift and
          // lock checks (b3-txn-core.mjs:28/:38).
          // INERTNESS, stated for the REAL blast radius [panel r4]: this clause
          // gates DELETE on EVERY users/{uid} subcollection, and two of those do
          // have live client deletes — sessionService.js:163 (session_states, a
          // hot path on every day advance) and db.js:3203 (class_progress). Both
          // stay legal because the guard fires only on a doc that CARRIES a fence
          // field, and the fence is written solely to progress_meta (or
          // list_progress once LIST_PROGRESS_CANONICAL flips) by resetProgress —
          // never to session_states or class_progress. Fixtured: E12 deletes an
          // unfenced progress doc and still ALLOWS.
          && !resource.data.keys().hasAny(resetFenceKeys());
      }
    }

    // CLASSES
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacher();
      allow update: if isAuthenticated() && (
        resource.data.ownerTeacherId == request.auth.uid ||
        // Self-enrollment (joinClass) updates studentCount AND studentIds together;
        // both must be allowed or the studentIds write is rejected and the student
        // becomes a "phantom" member (present in members/ but missing from studentIds).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'studentIds'])
      );
      allow delete: if isAuthenticated()
        && resource.data.ownerTeacherId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isOwner(memberId);
        allow delete: if isAuthenticated() && (
          isOwner(memberId) ||
          get(/databases/$(database)/documents/classes/$(classId)).data.ownerTeacherId == request.auth.uid
        );
      }

      match /words/{wordId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/classes/$(classId)).data.ownerTeacherId == request.auth.uid;
      }
    }

    // LISTS
    match /lists/{listId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacher();
      allow update, delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      match /words/{wordId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid;
      }
    }

    // ATTEMPTS
    // ⚠️ The attempt-write lockdown (W3) is NOT applied here yet — it is STAGED in
    //    `docs/plans/W3_attempts_lockdown.rules.md` and must be applied as the FINAL deploy step,
    //    only after SERVER_CHALLENGE_WRITE + SERVER_REVIEW_MARKER are ON + validated. Keeping the
    //    live rules unchanged keeps this file safe to deploy at any time (Codex: don't carry the
    //    lockdown live while the client still falls back to direct attempt writes).
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        // DEEPFIX2 [CLAUSE 5(a)]: the force-pass/engine stamp surface is
        // server-only — a client-created attempt must not carry it.
        && !request.resource.data.keys().hasAny(serverOnlyAttemptKeys())
        // DEEPFIX2 [NTF 19+22 · G1]: …nor may it be NAMED into the engine's
        // reserved `rv2_` id space (isReservedEngineDocId above — the
        // permanent-denial squat; matrix cases RV1-RV14 + GJ16).
        && !isReservedEngineDocId(attemptId)
        // …and neither may it claim the manual-anchor docId, which is a SYNONYM
        // for that field: scripts/cs/deepfix-census{,2}.mjs and the migration
        // WRITER deepfix-migrate-list-progress.mjs:198 all treat a `_manual` id
        // as equivalent to manualOverride === true [panel r5]. The real writers
        // (foundation.js:2971, scripts/cs/manual-pass.mjs) are Admin SDK and
        // bypass rules, so this denies nothing legitimate.
        && !attemptId.matches('.*[Mm]anual.*');

      // Student-side updates are limited to the `answers` array (for
      // submitChallenge, which mutates a nested challengeStatus on a single
      // answer). Score, passed, credibility, retention, gradedBy and similar
      // fields cannot be touched from the client.
      // Teacher updates: only the teacher of record for this attempt.
      allow update: if isAuthenticated()
        // ── DEEPFIX2 [codex r78 BLOCKER] THE MARKED-DOCUMENT GUARD ────────────
        // Every other condition in this clause guards the INCOMING write. NOTHING
        // guarded the EXISTING document, so an owner could leave every protected
        // marker and the top-level score untouched while REPLACING `answers` on an
        // already engine-stamped attempt. That payload is grade-bearing:
        // completeDay classifies the record as engine evidence from `resetEpoch`
        // PRESENCE alone (completion.js:340), then validates only the correct-COUNT
        // against the stored score (completion.js:377-379 — no wordId is ever
        // compared against the server presentation), then maps the stored rows
        // straight into graduation (completion.js:601-603). A same-count
        // permutation of `isCorrect` across word IDs therefore satisfies the
        // arithmetic while letting the CLIENT choose which words graduate and
        // receive the server-written `reviewRestingUntil` (completion.js:716-721).
        //
        // HOISTED above the student|teacher OR deliberately: it must cover BOTH
        // branches from ONE expression. Writing it into the student branch alone
        // would leave the teacher-of-record branch — which can also address a
        // future engine document — as the surviving sibling, and "guard the
        // operation the reviewer named, miss its siblings" is the exact defect
        // class r2, r3, r4 and r5 each re-found in a different operation.
        //
        // WHY THE ENGINE SET AND NOT serverOnlyAttemptKeys() — the compatibility
        // decision r78 asked to be made explicitly:
        //   * BROADER than the review's stated minimum `hasAny(['resetEpoch'])`.
        //     Guarding only the one key a reviewer happened to name is the defect
        //     being repaired; and since the create guard denies a client all four,
        //     the presence of ANY of them already proves server authorship.
        //     [NTF-20: both legs established — see the citation on
        //     isEngineStampedAttempt(): the create guard is live in production
        //     (2026-08-03 deploy) and the full-corpus provenance scan found
        //     zero historical carriers of any of the four keys.]
        //   * NARROWER than the full marker set, on purpose. manualOverride and
        //     teacherEdited* DO occur on historical documents — both are counted
        //     over the real cohort at scripts/deepfix2/b1-replay-lib.mjs:63-70 —
        //     and an answers update on such a document is LEGAL in the live base.
        //     Using the full set would convert a live-legal write into a denial
        //     for the 947-student cohort: a regression strictly worse than the bug.
        //     Engine attempts by contrast DO NOT EXIST in the live base
        //     (REVIEW_V2_CLIENT=false, src/config/featureFlags.js:243; the stamps
        //     are written only by reviewV2/callables.js through the Admin SDK), so
        //     this guard is purely ADDITIVE to live behaviour. Fixtured both ways:
        //     AE1-AE13 deny every path into the engine document, AE14/AE15 keep the
        //     marked-but-NON-engine document writable, and 9-a5/9-a7/A12 keep the
        //     ordinary legacy student and teacher paths green.
        //   * CONSEQUENCE, stated now rather than discovered later: once engine
        //     attempts exist, the client-side reviewChallenge fallback
        //     (src/services/db.js:2950 — live today, since SERVER_OVERRIDE=false)
        //     can no longer edit one. Challenge review of an engine attempt must
        //     go through the `reviewChallenge` callable (Admin SDK, rules-bypassing).
        //     That is the fail-closed direction, which is what makes the guard safe
        //     to carry before the engine ships.
        && !isEngineStampedAttempt()
        // DEEPFIX2 [NTF 19+22 · G1]: rv2_-NAMED documents are engine-owned —
        // no client update of ANY shape. Hoisted above the student|teacher OR
        // for the same sibling-coverage reason as the marked-document guard
        // above (matrix RV3/RV12/RV13).
        && !isReservedEngineDocId(attemptId)
        && (
        (resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])) ||
        (resource.data.teacherId == request.auth.uid && isTeacher()
          // DEEPFIX2 [CLAUSE 5(a)]: teacher-of-record edits stay legal, but the
          // override labels + engine stamp are Admin-SDK-only (forge-proof).
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyAttemptKeys()))
      );

      // Allow students to delete their own attempts (for progress reset)
      // DEEPFIX2 [CLAUSE 5 + the r54 erasure law] — deleting an attempt that
      // carries a server-written marker erases evidence, so those are protected.
      // `manualOverride` is the marker the LIVE override writers actually stamp
      // (functions/foundation.js:2985 and scripts/cs/manual-pass.mjs:70); the
      // other keys are the FUTURE force-pass surface (DF2-10 leg 7, not built)
      // and the engine's `gatePosture` stamp (callables.js, dark).
      //
      // WHAT THIS DOES NOT PROTECT [panel r3 — the first wording over-claimed]:
      // an ORDINARY passed-`new` attempt carries NO marker at all, and today
      // every one of the 947 students' CSD/TWI anchors is exactly that. Rules
      // cannot distinguish it from any other attempt, so it stays deletable —
      // protecting it would mean denying all client attempt deletes, i.e. P6
      // semantics, which this file deliberately does not bring forward.
      // Inert today: no client-written attempt carries any of these keys, the
      // live reset path is the Admin-SDK callable, and progressService.js:92 is
      // LOG-ONLY under LIST_SCOPED_RECON.
      allow delete: if isAuthenticated()
        && resource.data.studentId == request.auth.uid
        // DEEPFIX2 [NTF 19+22 · G1]: rv2_-named documents are engine-owned —
        // delete stays denied by NAME even for the squatter/creator, so
        // delete-then-recreate dies at BOTH halves (matrix RV4/RV9).
        && !isReservedEngineDocId(attemptId)
        && !resource.data.keys().hasAny(serverOnlyAttemptKeys());
    }

    // SYSTEM LOGS (for reconciliation events)
    match /system_logs/{logId} {
      // DEEPFIX2 [panel F11]: unchanged from the live base, but stated honestly —
      // create requires only auth and binds no uid, so rows are CLIENT-ATTRIBUTABLE:
      // anyone can write a row naming another student. Never an ENGINE authority
      // signal; CS must cross-check uid/createTime before treating a row (e.g.
      // csd_anchor_invalid) as evidence.
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && isTeacher();
    }

    // PHASE 1 — grading_jobs: server-owned (written ONLY by Cloud Functions via Admin SDK,
    // which bypasses rules). Clients may READ their own job (lost-response recovery via
    // getGradingStatus reads server-side, but allow direct owner-read for an optional snapshot);
    // clients may NEVER create/update/delete (the grade cache must be forge-proof — the docId is
    // the predictable attemptDocId). All client writes denied.
    match /grading_jobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ================================================================
    // DEEPFIX2 REVIEW-V2 [CLAUSES 3/4/4b/4c, firestore.review_v2.rules]
    // New top-level collections — none existed before the dark train.
    // ================================================================

    // CLAUSE 3: engine posture config — client-readable, never client-writable.
    // The LITERAL doc, not a wildcard: nothing else exists under system_config.
    match /system_config/review_v2 {
      allow read: if isAuthenticated();   // posture UI reads {enabled, threshold, minClientVersion, ...}
      allow write: if false;              // fireadmin (David) + Admin SDK only — the flip surface
    }

    // CLAUSE 4: AI grading meters — server-incremented, teacher-readable.
    match /ai_metering/{meterId} {
      // teacher-GATED, not confidential: `role` is self-asserted at signup (see
      // the users block). Real confidentiality needs a custom claim or an
      // Admin-SDK read path. Nothing student-identifying lives here.
      allow read: if isAuthenticated() && isTeacher();
      allow write: if false;              // incremented in the grading-job claim txn (Admin SDK)
    }

    // CLAUSE 4b: operational sink — server-only writes, teacher-readable.
    match /ops_metrics/{metricId} {
      allow read: if isAuthenticated() && isTeacher();
      allow write: if false;              // composition_fallback / saturation / abort signals
    }

    // CLAUSE 4c: shadow-audit membership set — fully server-side.
    match /shadow_registry/{chunkId} {
      allow read: if false;               // Admin SDK reads only; clients never see it
      allow write: if false;              // the audit driver writes; deleted at cleanup
    }

    // ========================================
    // AP BOOST COLLECTIONS
    // ========================================

    // AP TESTS - Public tests readable by all, teachers can write
    match /ap_tests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP QUESTIONS - Readable by all (answer keys are in ap_answer_keys, not here)
    match /ap_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP STIMULI - Readable by all authenticated users
    match /ap_stimuli/{stimulusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP ANSWER KEYS - Teachers + Admin SDK only (students must never read)
    match /ap_answer_keys/{questionId} {
      allow read, write: if isAuthenticated() && isTeacher();
    }

    // AP SESSION STATE - Server creates; students update safe fields only
    match /ap_session_state/{sessionId} {
      // Students read own sessions; teachers read for monitoring
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTeacher()
      );
      // Only Cloud Function (Admin SDK) can create sessions
      allow create: if false;
      // Students can update ONLY safe fields on their own sessions
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answers', 'flaggedQuestions', 'annotations', 'strikethroughs',
                    'currentSectionIndex', 'currentQuestionIndex', 'sectionTimeRemaining',
                    'lastAction', 'lastHeartbeat', 'sessionToken', 'status']);
    }

    // AP TEST RESULTS - Immutable for students; only server creates, only teacher updates (grading)
    match /ap_test_results/{resultId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTeacher()
      );
      // Only Cloud Function (Admin SDK) can create results
      allow create: if false;
      // Only the test creator (teacher) can update (for grading)
      allow update: if isAuthenticated() && isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    // AP CLASSES - Teachers manage, students read if enrolled
    match /ap_classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP ASSIGNMENTS - Teachers create, students read their assignments
    match /ap_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

  }
}
