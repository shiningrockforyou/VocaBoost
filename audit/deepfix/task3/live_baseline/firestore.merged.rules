// ============================================================================
// DEEPFIX2 MERGED RULES ARTIFACT — live base + review-v2 clauses (17_ §7b)
// BASE: the ruleset LIVE in production, fetched 2026-08-03 by fetch-live-rules.mjs
//   (rulesets/d8f3e0d0-8e8b-4fe1-aff8-9aceb1d5f9c4, created 2026-06-28,
//   sha256 44914b60858a1dcd… — re-verify freshness at deploy time; a drifted
//   sha means RE-DERIVE this merge).
// CLAUSES: authored from audit/deepfix/task3/firestore.review_v2.rules (the
//   131-line SPEC) against THIS base's shape. Deltas: (A) the users/{uid}
//   subcollection write split with the nine-new-subcollection exclusion + the
//   six-label study_states guards; (B) attempt override-key guards on the two
//   live client write branches; (C) four new top-level matches. NO P6/P10
//   narrowing is introduced: list_progress/class_progress/progress_meta and
//   the legacy attempt writes stay exactly as live (the inertness law).
// NOT the repo's firestore.rules (that is the unshipped P10 end-state).
// WHAT THIS FILE DELIBERATELY DOES **NOT** CLOSE — do not read it as forge-proof:
//   * `currentStudyDay` / `totalWordsIntroduced` (csd/twi) stay OWNER-WRITABLE.
//     The engine reads them as the frontier and review-universe authority
//     (functions/reviewV2/progress.js:62-70), so a student can still forge their
//     own day position. That is the LIVE legacy posture the app depends on; its
//     closure is carded to P6/DF2-46, and matrix case 10b asserts it as a
//     DEFERRED SURFACE, never as an inertness proof.
//   * Client attempt create / answers-only update / plain delete stay legal
//     (load-bearing until DF2-46), so attempt HISTORY remains client-shaped.
//   * `role` is self-asserted at signup, so `isTeacher()` is an availability
//     gate, not a confidentiality boundary (see the users block).
//
// TWO DELTA GROUPS, deliberately distinguishable:
//   (1) SPEC-MANDATED — the nine-subcollection exclusion, the six-label
//       study_states guards, the attempt override-key guards (create/update per
//       CLAUSE 5(a); delete added by the r54 erasure law), the four new
//       top-level matches.
//   (2) HARDENING BEYOND THE SPEC (r-panel forgery lens): `role` made
//       create-only (F1), and the server-only reset/epoch fence
//       (resetAt/resetEpoch/resetInProgress) made client-unwritable (F2/F3).
//       BOTH verified inert against the live client tree before authoring.
// Gate: the emulator matrix (rules-matrix.mjs) must pass on THIS file.
// ============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return getUserData().role == 'teacher';
    }

    // ADMIN: Collection group rule for class_progress (enables admin dashboard).
    // Read-only and teacher-only — student/own-progress writes go through the
    // owner rule under /users/{userId}/class_progress.
    // SECURITY: previously `allow read, write: if isAuthenticated();` permitted
    // any authenticated user to corrupt any student's progress doc.
    match /{path=**}/class_progress/{docId} {
      allow read: if isAuthenticated() && isTeacher();
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuthenticated();

      // DEEPFIX2 [HARDENING, beyond the spec — panel F1, CORRECTED at panel r2]:
      // the live base let an owner rewrite their OWN `role` in place, and
      // isTeacher() reads that field. The write is split so an UPDATE can never
      // touch `role`, and DELETE is closed so the guard cannot be bypassed by
      // delete-then-recreate (panel r2 found that two-call path; my first
      // "create-only" claim was wrong). VERIFIED no live writer: role is
      // written only at doc creation (AuthContext.jsx:75 signup; :113 Google,
      // guarded by !userSnap.exists()); seedFullData.js:958 restates an
      // IDENTICAL value behind TeacherRoute, which diff() omits from
      // affectedKeys (matrix R5); db.js:286 touches profile only; and no CLIENT
      // path deletes a users doc. The one account-deletion flow is
      // scripts/cs/erase-account.mjs (Admin SDK, rules-bypassing), which deletes
      // the users doc AND the Auth identity in the same run — and that
      // auth.deleteUser call is LOAD-BEARING here: `create` is bare isOwner, so
      // a surviving uid whose doc was erased could re-create it as a teacher.
      //
      // WHAT THIS DOES NOT BUY — read before trusting `isTeacher()`:
      // `role` is SELF-ASSERTED AT SIGNUP (src/pages/Signup.jsx:124-149 renders
      // a public "Teacher" radio that db.js:254 writes verbatim), so anyone with
      // an email can hold role:'teacher' from the start. These clauses stop an
      // ESTABLISHED account from escalating in place; they do NOT make 'teacher'
      // a confidentiality boundary. Closing that is a PRODUCT decision (gated
      // teacher registration, or class-scoped teacher grants), carded to David.
      allow create: if isAuthenticated() && isOwner(userId);

      allow update: if isAuthenticated() && (
        (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        (isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challenges']))
      );

      // Closed [panel r2]: delete + recreate was a two-call bypass of the role
      // guard. No client path deletes a users doc, so this denies nothing live.
      allow delete: if false;

      // TODO(security): teacher writes here exist solely to support
      // reviewChallenge (writes student's study_states + class_progress when
      // accepting/rejecting a dispute). This is overly broad — any teacher
      // account can write any student's subcollections regardless of class
      // membership. Follow-up: move reviewChallenge to a Cloud Function
      // (Admin SDK bypasses rules) and tighten this to `isOwner(userId)`.
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isTeacher());

        // DEEPFIX2 review-v2 [CLAUSE 1+2, firestore.review_v2.rules]: the NINE
        // server-owned subcollections accept NO client writes (Admin SDK only),
        // and the SIX server label fields on study_states are client-immutable
        // (create/update) and non-erasable (delete). Everything else preserves
        // the live owner-or-teacher branch verbatim — list_progress /
        // class_progress / progress_meta / plain study_states stay writable
        // exactly as before (the inertness law: only surfaces that do not
        // exist pre-train are guarded).
        allow create: if isAuthenticated() && (isOwner(userId) || isTeacher())
          && !(subcollection in ['review_queues', 'review_presentations', 'day_completions',
               'streak_credits', 'restudy_completions', 'restudy_visits',
               'review_counters', 'review_cursors', 'compose_keys'])
          && !(subcollection == 'study_states'
               && request.resource.data.keys().hasAny([
                    'reviewFailCount', 'reviewLastFailedAt', 'reviewLastCorrectAt',
                    'reviewLastProvenAt', 'reviewLastTestedAt', 'reviewRestingUntil' ]))
          && !request.resource.data.keys().hasAny([
               'resetAt', 'resetEpoch', 'resetInProgress' ]);

        allow update: if isAuthenticated() && (isOwner(userId) || isTeacher())
          && !(subcollection in ['review_queues', 'review_presentations', 'day_completions',
               'streak_credits', 'restudy_completions', 'restudy_visits',
               'review_counters', 'review_cursors', 'compose_keys'])
          && !(subcollection == 'study_states'
               && request.resource.data.diff(resource.data).affectedKeys().hasAny([
                    'reviewFailCount', 'reviewLastFailedAt', 'reviewLastCorrectAt',
                    'reviewLastProvenAt', 'reviewLastTestedAt', 'reviewRestingUntil' ]))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'resetAt', 'resetEpoch', 'resetInProgress' ]);

        allow delete: if isAuthenticated() && (isOwner(userId) || isTeacher())
          && !(subcollection in ['review_queues', 'review_presentations', 'day_completions',
               'streak_credits', 'restudy_completions', 'restudy_visits',
               'review_counters', 'review_cursors', 'compose_keys'])
          && !(subcollection == 'study_states'                     // label-ERASURE guard [r54]
               && resource.data.keys().hasAny([
                    'reviewFailCount', 'reviewLastFailedAt', 'reviewLastCorrectAt',
                    'reviewLastProvenAt', 'reviewLastTestedAt', 'reviewRestingUntil' ]))
          // The reset fence must survive DELETION too [panel r3 BLOCKER]: guarding
          // only create+update left delete-then-recreate as a clean bypass, which
          // would fork the day_completions CAS namespace (composer.js:154 reads 0
          // for an absent doc), clear the §2b fail-closed reset lock
          // (composer.js:166), and walk the GATE-4 backfill past its own drift and
          // lock checks (b3-txn-core.mjs:28/:38). Inert: no client path deletes
          // progress_meta or list_progress.
          && !resource.data.keys().hasAny([
               'resetAt', 'resetEpoch', 'resetInProgress' ]);
      }
    }

    // CLASSES
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacher();
      allow update: if isAuthenticated() && (
        resource.data.ownerTeacherId == request.auth.uid ||
        // Self-enrollment (joinClass) updates studentCount AND studentIds together;
        // both must be allowed or the studentIds write is rejected and the student
        // becomes a "phantom" member (present in members/ but missing from studentIds).
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount', 'studentIds'])
      );
      allow delete: if isAuthenticated()
        && resource.data.ownerTeacherId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isOwner(memberId);
        allow delete: if isAuthenticated() && (
          isOwner(memberId) ||
          get(/databases/$(database)/documents/classes/$(classId)).data.ownerTeacherId == request.auth.uid
        );
      }

      match /words/{wordId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/classes/$(classId)).data.ownerTeacherId == request.auth.uid;
      }
    }

    // LISTS
    match /lists/{listId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTeacher();
      allow update, delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      match /words/{wordId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid;
      }
    }

    // ATTEMPTS
    // ⚠️ The attempt-write lockdown (W3) is NOT applied here yet — it is STAGED in
    //    `docs/plans/W3_attempts_lockdown.rules.md` and must be applied as the FINAL deploy step,
    //    only after SERVER_CHALLENGE_WRITE + SERVER_REVIEW_MARKER are ON + validated. Keeping the
    //    live rules unchanged keeps this file safe to deploy at any time (Codex: don't carry the
    //    lockdown live while the client still falls back to direct attempt writes).
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.studentId == request.auth.uid
        // DEEPFIX2 [CLAUSE 5(a)]: the force-pass/engine stamp surface is
        // server-only — a client-created attempt must not carry it.
        && !request.resource.data.keys().hasAny([
             'teacherEdited', 'teacherEditedBy', 'teacherEditedAt', 'preOverride', 'gatePosture' ]);

      // Student-side updates are limited to the `answers` array (for
      // submitChallenge, which mutates a nested challengeStatus on a single
      // answer). Score, passed, credibility, retention, gradedBy and similar
      // fields cannot be touched from the client.
      // Teacher updates: only the teacher of record for this attempt.
      allow update: if isAuthenticated() && (
        (resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])) ||
        (resource.data.teacherId == request.auth.uid && isTeacher()
          // DEEPFIX2 [CLAUSE 5(a)]: teacher-of-record edits stay legal, but the
          // override labels + engine stamp are Admin-SDK-only (forge-proof).
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'teacherEdited', 'teacherEditedBy', 'teacherEditedAt', 'preOverride', 'gatePosture' ]))
      );

      // Allow students to delete their own attempts (for progress reset)
      // DEEPFIX2 [CLAUSE 5 + the r54 erasure law] — deleting an attempt that
      // carries a server-written marker erases evidence, so those are protected.
      // `manualOverride` is the marker the LIVE override writers actually stamp
      // (functions/foundation.js:2985 and scripts/cs/manual-pass.mjs:70); the
      // other keys are the FUTURE force-pass surface (DF2-10 leg 7, not built)
      // and the engine's `gatePosture` stamp (callables.js, dark).
      //
      // WHAT THIS DOES NOT PROTECT [panel r3 — the first wording over-claimed]:
      // an ORDINARY passed-`new` attempt carries NO marker at all, and today
      // every one of the 947 students' CSD/TWI anchors is exactly that. Rules
      // cannot distinguish it from any other attempt, so it stays deletable —
      // protecting it would mean denying all client attempt deletes, i.e. P6
      // semantics, which this file deliberately does not bring forward.
      // Inert today: no client-written attempt carries any of these keys, the
      // live reset path is the Admin-SDK callable, and progressService.js:92 is
      // LOG-ONLY under LIST_SCOPED_RECON.
      allow delete: if isAuthenticated()
        && resource.data.studentId == request.auth.uid
        && !resource.data.keys().hasAny([
             'manualOverride', 'teacherEdited', 'teacherEditedBy', 'teacherEditedAt',
             'preOverride', 'gatePosture' ]);
    }

    // SYSTEM LOGS (for reconciliation events)
    match /system_logs/{logId} {
      // DEEPFIX2 [panel F11]: unchanged from the live base, but stated honestly —
      // create requires only auth and binds no uid, so rows are CLIENT-ATTRIBUTABLE:
      // anyone can write a row naming another student. Never an ENGINE authority
      // signal; CS must cross-check uid/createTime before treating a row (e.g.
      // csd_anchor_invalid) as evidence.
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && isTeacher();
    }

    // PHASE 1 — grading_jobs: server-owned (written ONLY by Cloud Functions via Admin SDK,
    // which bypasses rules). Clients may READ their own job (lost-response recovery via
    // getGradingStatus reads server-side, but allow direct owner-read for an optional snapshot);
    // clients may NEVER create/update/delete (the grade cache must be forge-proof — the docId is
    // the predictable attemptDocId). All client writes denied.
    match /grading_jobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ================================================================
    // DEEPFIX2 REVIEW-V2 [CLAUSES 3/4/4b/4c, firestore.review_v2.rules]
    // New top-level collections — none existed before the dark train.
    // ================================================================

    // CLAUSE 3: engine posture config — client-readable, never client-writable.
    // The LITERAL doc, not a wildcard: nothing else exists under system_config.
    match /system_config/review_v2 {
      allow read: if isAuthenticated();   // posture UI reads {enabled, threshold, minClientVersion, ...}
      allow write: if false;              // fireadmin (David) + Admin SDK only — the flip surface
    }

    // CLAUSE 4: AI grading meters — server-incremented, teacher-readable.
    match /ai_metering/{meterId} {
      // teacher-GATED, not confidential: `role` is self-asserted at signup (see
      // the users block). Real confidentiality needs a custom claim or an
      // Admin-SDK read path. Nothing student-identifying lives here.
      allow read: if isAuthenticated() && isTeacher();
      allow write: if false;              // incremented in the grading-job claim txn (Admin SDK)
    }

    // CLAUSE 4b: operational sink — server-only writes, teacher-readable.
    match /ops_metrics/{metricId} {
      allow read: if isAuthenticated() && isTeacher();
      allow write: if false;              // composition_fallback / saturation / abort signals
    }

    // CLAUSE 4c: shadow-audit membership set — fully server-side.
    match /shadow_registry/{chunkId} {
      allow read: if false;               // Admin SDK reads only; clients never see it
      allow write: if false;              // the audit driver writes; deleted at cleanup
    }

    // ========================================
    // AP BOOST COLLECTIONS
    // ========================================

    // AP TESTS - Public tests readable by all, teachers can write
    match /ap_tests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP QUESTIONS - Readable by all (answer keys are in ap_answer_keys, not here)
    match /ap_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP STIMULI - Readable by all authenticated users
    match /ap_stimuli/{stimulusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP ANSWER KEYS - Teachers + Admin SDK only (students must never read)
    match /ap_answer_keys/{questionId} {
      allow read, write: if isAuthenticated() && isTeacher();
    }

    // AP SESSION STATE - Server creates; students update safe fields only
    match /ap_session_state/{sessionId} {
      // Students read own sessions; teachers read for monitoring
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTeacher()
      );
      // Only Cloud Function (Admin SDK) can create sessions
      allow create: if false;
      // Students can update ONLY safe fields on their own sessions
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answers', 'flaggedQuestions', 'annotations', 'strikethroughs',
                    'currentSectionIndex', 'currentQuestionIndex', 'sectionTimeRemaining',
                    'lastAction', 'lastHeartbeat', 'sessionToken', 'status']);
    }

    // AP TEST RESULTS - Immutable for students; only server creates, only teacher updates (grading)
    match /ap_test_results/{resultId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isTeacher()
      );
      // Only Cloud Function (Admin SDK) can create results
      allow create: if false;
      // Only the test creator (teacher) can update (for grading)
      allow update: if isAuthenticated() && isTeacher()
        && resource.data.teacherId == request.auth.uid;
    }

    // AP CLASSES - Teachers manage, students read if enrolled
    match /ap_classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

    // AP ASSIGNMENTS - Teachers create, students read their assignments
    match /ap_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTeacher();
    }

  }
}
